# NuGet dependencies for the Fable synthesizer.
#
# NOTE: the project builds out of the box with plain PackageReference entries
# in src/App.fsproj (no paket required). This file is provided for teams that
# prefer Paket — run `dotnet paket convert-from-nuget` or wire up
# Paket.Restore.targets manually if you adopt it.

source https://api.nuget.org/v3/index.json
framework: net8.0
storage: none

nuget Fable.Core ~> 4.3
nuget Fable.Browser.Dom ~> 2.16
nuget Fable.Browser.Blob ~> 1.3
nuget Fable.Browser.Url ~> 1.3
nuget Fable.Browser.WebStorage ~> 1.2
nuget Fable.Elmish ~> 4.2
nuget Feliz ~> 2.8
nuget Feliz.UseElmish ~> 2.5
nuget Thoth.Json ~> 10.2
